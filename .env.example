# Copia este archivo a ".env" si quieres cambiar las credenciales por
# defecto. Si no creas el .env, docker-compose usa los valores por
# defecto definidos en docker-compose.yml (mismos que conexion.php
# espera cuando no hay variables de entorno).
DB_NAME=redytelca
DB_USER=redytelca
DB_PASS=redytelca_pass
DB_ROOT_PASS=root_pass
